# Partie 3 - Q3 : acces simultane limite a N (Singleton + semaphore)
import threading
import time


class LimitedResource:
    _instance = None
    _lock = threading.Lock()
    MAX_ACCESS = 3

    def __new__(cls):
        with cls._lock:
            if cls._instance is None:
                inst = super().__new__(cls)
                inst._sem = threading.BoundedSemaphore(cls.MAX_ACCESS)
                inst._count_lock = threading.Lock()
                inst.active = 0
                inst.max_seen = 0
                cls._instance = inst
        return cls._instance

    def use(self, who):
        with self._sem:                      # max 3 en meme temps
            with self._count_lock:
                self.active += 1
                self.max_seen = max(self.max_seen, self.active)
                print(f"{who} entre   (acces actifs : {self.active})")
            time.sleep(0.2)                  # travail sur la ressource
            with self._count_lock:
                self.active -= 1
                print(f"{who} sort    (acces actifs : {self.active})")


if __name__ == "__main__":
    res = LimitedResource()
    threads = [threading.Thread(target=LimitedResource().use, args=(f"T{i}",))
               for i in range(1, 7)]
    for t in threads:
        t.start()
    for t in threads:
        t.join()
    print("Maximum d'acces simultanes observe :", res.max_seen,
          "(limite =", LimitedResource.MAX_ACCESS, ")")
